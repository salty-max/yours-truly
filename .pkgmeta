# The BigWigs packager's settings (.github/workflows/release.yml). The addon
# is addon/YoursTruly, shipped as it is (one zip for every game: each loads its
# own TOC); the rest of the repository stays out (the release checks the
# package is the folder, nothing more). The notes are the tag's message,
# written to .release-notes.md by the workflow.
package-as: YoursTruly

move-folders:
  YoursTruly/addon/YoursTruly: YoursTruly

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - assets
  - addon/test
  - addon/CURSEFORGE.md
  - docs
  - i18n
  - letters
  - scripts
  - CLAUDE.md
  - LICENSE
  - README.md
  - package.json
  - saved-ids.json
  - selene.toml
  - stylua.toml
  - wow.yml
